{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/studentos/scripts/hooks/check-invented-data.mjs"],
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/studentos/scripts/hooks/check-new-deps.mjs"],
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
