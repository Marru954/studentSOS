# Workspace: studentos/ (Next.js) at the repo root alongside repo-level scripts/docs (the old uniportal/ scaffold and HTML mockups were removed).
# Patterns without a leading slash match at any depth.

# dependencies
node_modules/
.pnp
.pnp.*

# builds / generated output
.next/
out/
dist/
build/
*.tsbuildinfo

# testing
coverage/

# playwright-mcp browser snapshots (accidental MCP dumps, not test infra)
.playwright-mcp/

# environment & secrets (keep the example, drop real values and keys)
.env
.env.*
!.env.example
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# os / editor
.DS_Store

# deploy
.vercel

# local agent/session config
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/settings.json
